# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Public app URL (used in password reset links)
APP_BASE_URL=https://paint-web-app-taupe.vercel.app

# Password reset email via Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Paint App <onboarding@resend.dev>

# Social OAuth
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# OpenAI Magic transform
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, defaults to gpt-image-1
OPENAI_IMAGE_MODEL=gpt-image-1
